# Optional: endpoint that accepts the Connect brief as JSON (POST).
# e.g. a Formspree form URL or your own API route. Leave empty to use the
# mailto: fallback (the button then says "Send brief via email app").
VITE_FORM_ENDPOINT=

# Optional: your own proxy that forwards TMDB search requests (keeps the key
# server-side). Leave empty: Lab "Film alive" uses local offline images.
VITE_TMDB_PROXY=
