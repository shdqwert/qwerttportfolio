{
  "name": "qwerttportfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.js",
    "preview": "vite preview",
    "lint": "oxlint && node scripts/check-css-modules.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "node scripts/images.mjs",
    "test:visual": "playwright test tests/visual",
    "test:perf": "playwright test tests/perf",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.27",
    "matter-js": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
